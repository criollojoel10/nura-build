# Stub de sabor de kernel. Nura no compila el kernel aqui: la imagen de boot
# sale de tools/build-boot-image.py con el Image del workflow kernel.yml.
# pmbootstrap, sin embargo, exige que exista exactamente un sabor de kernel
# para poder correr mkinitfs (si no: "only one kernel release/flavor is
# supported, found: []"), y boot-deploy exige /boot/vmlinuz*. Este paquete
# aporta solo esos dos requisitos; no instala modulos ni DTBs.
#
# El initramfs de /boot que genera pmbootstrap no se usa: el del telefono lo
# arma tools/build-initramfs.sh.
pkgname=linux-xiaomi-ruby
pkgver=6.6.143
pkgrel=0
pkgdesc="Stub kernel flavor for ruby (real Image is flashed by tools/build-boot-image.py)"
arch="aarch64"
url="https://github.com/criollojoel10/ruby-nura"
license="GPL-2.0-only"
options="!check !strip !tracedeps"
source="kernel.release vmlinuz-xiaomi-ruby"

package() {
	install -Dm644 "$srcdir"/kernel.release \
		"$pkgdir"/usr/share/kernel/xiaomi-ruby/kernel.release
	install -Dm644 "$srcdir"/vmlinuz-xiaomi-ruby \
		"$pkgdir"/boot/vmlinuz-xiaomi-ruby
}

sha512sums="
