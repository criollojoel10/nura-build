# Reference: <https://postmarketos.org/devicepkg>
maintainer="Joel Criollo <criollojoel10@users.noreply.github.com>"
pkgname=device-xiaomi-ruby
pkgdesc="Xiaomi Redmi Note 12 Pro 5G"
pkgver=1
# pkgrel must not be 0: apk would prefer the version published in pmaports
# edge instead of this local one.
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
# El kernel del ROM (6.6.143-…-Singularity) no se recompila: la imagen de boot
# la arma tools/build-boot-image.py. Por eso este paquete no depende de
# linux-xiaomi-ruby ni de mkbootimg, y deviceinfo declara
# deviceinfo_generate_bootimg="false". Solo aporta deviceinfo, cmdline y los
# modulos de initramfs, mas el arranque de Plasma en este kernel sin VT.
# SSH es la unica via de consola cuando no hay VT ni fbcon: el rootfs que
# venia de Kupfer lo traia y el build de CI no, asi que se declara aqui.
depends="
	postmarketos-base
	openssh
	"
makedepends="devicepkg-dev"
source="deviceinfo kernel-cmdline.conf modules-initfs
	10-nura-software.conf
	20-nura-notty.conf
	30-nura-zram.conf
	99-nura-journal.conf
	nura-takeover.sh
	nura-gpu-prep
	nura-backlight
	nura-shot
	nura-shot-run
	nura-zramstart
	nura-wifi.sh
	nura-wifi.service
	nura-bars-test
	nura-net-report
	nura-net-report.service
	nura-gpu-probe
	nura-gpu-probe.service
	nura-gpu-probe.timer
	nurafb.bin
	nura-dt-report
	nura-dt-report.service
	"
subpackages="$pkgname-kernel-xiaomi-ruby:kernel_xiaomi_ruby"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	# Plasma Mobile on a kernel without VT/fbcon and without a usable GPU:
	# KWin needs card0 for free (nurafb holds master), llvmpipe on dumb buffers,
	# the systemd user bus, and the backlight re-sent after each atomic resume.
	# See tools/kde/ and docs/STATUS.md.
	install -Dm755 "$srcdir"/nura-takeover.sh "$pkgdir"/usr/bin/nura-takeover
	install -Dm755 "$srcdir"/nura-gpu-prep "$pkgdir"/usr/bin/nura-gpu-prep
	install -Dm755 "$srcdir"/nura-backlight "$pkgdir"/usr/bin/nura-backlight
	install -Dm755 "$srcdir"/nura-shot "$pkgdir"/usr/bin/nura-shot
	install -Dm755 "$srcdir"/nura-shot-run "$pkgdir"/usr/bin/nura-shot-run
	install -Dm755 "$srcdir"/nura-zramstart "$pkgdir"/usr/bin/nura-zramstart
	install -Dm755 "$srcdir"/nura-wifi.sh "$pkgdir"/usr/bin/nura-wifi
	install -Dm644 "$srcdir"/nura-wifi.service "$pkgdir"/etc/systemd/system/nura-wifi.service
	install -Dm755 "$srcdir"/nura-bars-test "$pkgdir"/usr/bin/nura-bars-test
	install -Dm755 "$srcdir"/nura-net-report "$pkgdir"/usr/bin/nura-net-report
	install -Dm644 "$srcdir"/nura-net-report.service "$pkgdir"/etc/systemd/system/nura-net-report.service
	install -Dm755 "$srcdir"/nura-gpu-probe "$pkgdir"/usr/bin/nura-gpu-probe
	install -Dm644 "$srcdir"/nura-gpu-probe.service "$pkgdir"/etc/systemd/system/nura-gpu-probe.service
	install -Dm644 "$srcdir"/nura-gpu-probe.timer "$pkgdir"/etc/systemd/system/nura-gpu-probe.timer
	install -Dm755 "$srcdir"/nurafb.bin "$pkgdir"/usr/bin/nurafb
	install -Dm755 "$srcdir"/nura-dt-report "$pkgdir"/usr/bin/nura-dt-report
	install -Dm644 "$srcdir"/nura-dt-report.service "$pkgdir"/etc/systemd/system/nura-dt-report.service
	mkdir -p "$pkgdir"/etc/systemd/system/multi-user.target.wants
	ln -s /etc/systemd/system/nura-wifi.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/nura-wifi.service
	ln -s /etc/systemd/system/nura-dt-report.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/nura-dt-report.service
	ln -s /etc/systemd/system/nura-net-report.service \
		"$pkgdir"/etc/systemd/system/multi-user.target.wants/nura-net-report.service
	ln -s /etc/systemd/system/nura-gpu-probe.timer \
		"$pkgdir"/etc/systemd/system/timers.target.wants/nura-gpu-probe.timer
	for f in 10-nura-software.conf 20-nura-notty.conf; do
		install -Dm644 "$srcdir/$f" \
			"$pkgdir"/etc/systemd/system/plasma-mobile.service.d/"$f"
	done
	install -Dm644 "$srcdir"/30-nura-zram.conf \
		"$pkgdir"/etc/systemd/system/postmarketos-zram-swap.service.d/30-nura-zram.conf
	install -Dm644 "$srcdir"/99-nura-journal.conf \
		"$pkgdir"/etc/systemd/journald.conf.d/99-nura-journal.conf
}

kernel_xiaomi_ruby() {
	pkgdesc="Xiaomi Redmi Note 12 Pro 5G (kernel flavor xiaomi-ruby)"
	depends="linux-xiaomi-ruby"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}

