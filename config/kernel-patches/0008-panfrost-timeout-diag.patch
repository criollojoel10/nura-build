+	/* nura-diag: que job se cuelga y en que estado, para compararlo con el job
+	 * de la sonda offscreen, que si termina. */
+	dev_err(pfdev->dev, "nura-diag: timeout jc=0x%llx req=0x%llx flush_id=%u\n",
