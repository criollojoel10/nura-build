+		(unsigned long long)job->requirements,
+		job->flush_id);
+	dev_err(pfdev->dev, "nura-diag: JS next config=0x%x cmd=0x%x head_next=0x%x flush_next=0x%x\n",
+		job_read(pfdev, JS_CONFIG_NEXT(js)),
+		job_read(pfdev, JS_COMMAND_NEXT(js)),
+		job_read(pfdev, JS_HEAD_NEXT_LO(js)),
+		job_read(pfdev, JS_FLUSH_ID_NEXT(js)));
+	dev_err(pfdev->dev, "nura-diag: AS0 faultstatus=0x%x faultaddr=0x%llx transcfg=0x%x\n",
+		readl(pfdev->iomem + AS_FAULTSTATUS(0)),
+		((u64)readl(pfdev->iomem + AS_FAULTADDRESS_HI(0)) << 32) |
+			readl(pfdev->iomem + AS_FAULTADDRESS_LO(0)),
