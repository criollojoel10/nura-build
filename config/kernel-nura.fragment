# Fragmento Nura: se fusiona sobre ruby_defconfig (commit be1aa8e) en kernel.yml.
# Objetivo: /dev/tty0..ttyN y sesion VT para logind/Plasma. La consola de
# texto NO se enciende: FRAMEBUFFER_CONSOLE cuelga el kernel al enlazar fbcon
# dentro de drm_fb_helper_initial_config() -> register_framebuffer()
# (mtk_fbdev_probe ya retorno; ver docs/STATUS.md v4). Sin fbcon, VT_CONSOLE
# usa dummycon: crea /dev/tty* y permite el VT de logind sin pintar en el panel.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_PANFROST=m
# systemd recomienda FHANDLE; ruby_defconfig lo deja apagado.
CONFIG_FHANDLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_G_SERIAL=y
CONFIG_USB_F_ACM=y

# Userland Linux normal (el kernel del ROM ya trae esto activo; ruby_defconfig
# lo deja fuera). Sin esto no hay namespaces, IPC SysV ni contenedores.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_MACVLAN=y

# fbcon necesita fuentes en el kernel.
CONFIG_FONT_AUTOSELECT=y
CONFIG_FONT_8x16=y
