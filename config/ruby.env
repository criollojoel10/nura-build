# Ruby device environment (measured on-device 2026-11-05)
# Xiaomi Redmi Note 12 Pro 5G - MT6877V / Dimensity 1080
DEVICE=ruby
SOC=mt6877
KERNEL_VERSION=6.6.143
KERNEL_LOCALVERSION=-android15-8-4k-Singularity-gbe1aa8ecec91
# Android currently runs from slot _b; slot _a is untouched.
SLOT_ANDROID=_b
SLOT_SPARE=_a
# MTK Android boot image: header v2, page 2048, no init_boot, empty vendor_boot
BOOT_HEADER_VERSION=2
BOOT_PAGE_SIZE=2048
KERNEL_ADDR=0x40080000
RAMDISK_ADDR=0x51100000
TAGS_ADDR=0x47c80000
CMDLINE="bootopt=64S3,32N2,64N2 androidboot.tee_type=2 androidboot.init_fatal_reboot_target=recovery"
# Rootfs staging
# /data is FBE-encrypted: a cold-booted Linux kernel cannot mount it.
# Stage 1 target is the unallocated tail of `super` (~2.6 GiB, Android intact).
ROOTFS_IMAGE=/data/linux/ruby-rootfs.ext4
SUPER_FREE_OFFSET=6323392512
SUPER_FREE_BYTES=2803412992
ROOTFS_OFFSET=$SUPER_FREE_OFFSET
SUPER_SIZE=9126805504
DATA_FREE_HINT=191GiB
